{
	"name": "beautiful-css",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . && prettier --check .",
		"format": "eslint . --fix && prettier --write .",
		"registry:validate": "shadcn registry validate",
		"registry:consumer": "node scripts/validate-consumer.mjs",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots",
		"test:visual:report": "playwright show-report",
		"test:motion": "playwright test --config playwright.motion.config.ts",
		"test:behavior": "playwright test --config playwright.behavior.config.ts",
		"test:mobile": "playwright test --config playwright.mobile.config.ts",
		"validate": "yarn typecheck && yarn lint && yarn registry:validate && yarn registry:consumer && yarn build && yarn test:visual && yarn test:behavior && yarn test:mobile"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "22.20.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.5",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.6",
		"shadcn": "4.21.0",
		"typescript": "5.9.3"
	},
	"type": "module",
	"dependencies": {
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	}
}
